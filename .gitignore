# Generated by Cargo
# will have compiled files and executables
# `target/` is produced by Cargo at the workspace root and in `src-tauri/`.
target/

# Local environment files and secrets
.env
.env.*
!.env.example

# Package-manager caches
.pnpm-store/
.npm/

/dist/

# Leptos/WASM generated packages
**/pkg/
/debug/

# These are backup files generated by rustfmt
**/*.rs.bk

# node e2e test tools and outputs
node_modules/
test-results/
end2end/playwright-report/
playwright/.cache/
/coverage/
*.log
/.idea/

.DS_Store


# Tauri
src-tauri/gen/

# Graphify keeps the report and graph outputs useful for contributors, but
# ignores extractor caches and machine-local metadata.
graphify-out/cache/
graphify-out/.graphify_*
