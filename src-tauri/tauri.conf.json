{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Flow",
  "version": "0.1.0",
  "identifier": "com.focusflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:desktop && node scripts/serve-desktop.mjs",
    "devUrl": "http://127.0.0.1:4317",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Focus Flow",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Visible",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": []
  }
}
